{
	"bsonType": "object",
	"required": ["user_id", "device_id"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": { "description": "ID" },
		"user_id": { "bsonType": "string", "description": "用户ID（uni-id 或业务ID）" },
		"mobile": { "bsonType": "string", "description": "手机号" },
		"wx_openid": { "bsonType": "string", "description": "微信公众号openid" },
		"wx_unionid": { "bsonType": "string", "description": "微信unionid" },
		"device_id": { "bsonType": "string", "description": "绑定机具号" },
		"brand_name": { "bsonType": "string", "description": "品牌名" },
		"wx_nickname": { "bsonType": "string", "description": "微信用户（昵称）" },
		"wx_avatar": { "bsonType": "string", "description": "头像URL" },
		"agreement_img": { "bsonType": "string", "description": "协议图片URL" },
		"agreement_signed_at": { "bsonType": "timestamp", "description": "协议签署时间" },
		"agreement_version": { "bsonType": "string", "description": "协议版本" },
		"bind_time": { "bsonType": "timestamp", "description": "绑定时间" },
		"create_time": { "bsonType": "timestamp", "description": "商户注册/建档时间（流水优化满 N 天判定主字段）" },
		"remaining_quota": { "bsonType": "number", "description": "剩余额度", "default": 0 },
		"available_reward": { "bsonType": "number", "description": "可用奖励", "default": 0 },
		"estimated_free_quota": { "bsonType": "number", "description": "预估免额度", "default": 0 },
		"account_points": { "bsonType": "number", "description": "账号积分", "default": 0 },
		"pending_withdraw": { "bsonType": "number", "description": "待提现", "default": 0 },
		"withdrawn": { "bsonType": "number", "description": "已提现", "default": 0 },
		"frozen_amount": { "bsonType": "number", "description": "冻结金额", "default": 0 },
		"coupon_count": { "bsonType": "number", "description": "优惠券数量", "default": 0 },
		"use_status": { "bsonType": "number", "description": "使用状态：1正常，0异常", "default": 1 },
		"status": { "bsonType": "bool", "description": "使用状态开关（true启用/false禁用）", "default": true },
		"flag1": { "bsonType": "bool", "description": "开关1", "default": false },
		"flag2": { "bsonType": "bool", "description": "开关2", "default": false },
		"flag3": { "bsonType": "bool", "description": "开关3", "default": false },
		"micro_merchant": { "bsonType": "bool", "description": "小微商户", "default": false },
		"login_time": { "bsonType": "timestamp", "description": "最后登录时间（H5 鉴权登录或进入首页时刷新）" },
		"points_opt_week_applied": {
			"bsonType": "int",
			"description": "登录周优化：相对当前登录锚点已执行周数",
			"default": 0
		},
		"points_opt_update_time": { "bsonType": "timestamp", "description": "上次登录周优化时间" },
		"points_opt_whitelist": {
			"bsonType": "bool",
			"description": "登录周积分优化白名单：true 不受登录周优化",
			"default": false
		},
		"points_opt_whitelist_at": { "bsonType": "timestamp", "description": "加入登录周白名单时间" },
		"points_opt_whitelist_by": { "bsonType": "string", "description": "登录周白名单操作人" },
		"points_opt_whitelist_remark": { "bsonType": "string", "description": "登录周白名单备注" },
		"points_flow_opt_whitelist": {
			"bsonType": "bool",
			"description": "流水优化白名单：true 不进入按流水优化抽检（仍可进 §4 风控）",
			"default": false
		},
		"points_flow_opt_whitelist_at": { "bsonType": "timestamp", "description": "加入流水优化白名单时间" },
		"points_flow_opt_whitelist_by": { "bsonType": "string", "description": "流水优化白名单操作人" },
		"points_flow_opt_whitelist_remark": { "bsonType": "string", "description": "流水优化白名单备注" },
		"recharge_total_yuan": {
			"bsonType": "number",
			"description": "当前充值周期内用户已成功支付的累计金额（元），退款成功后清零",
			"default": 0
		},
		"recharge_amount": {
			"bsonType": "number",
			"description": "累计充值金额（元），退款成功后清零",
			"default": 0
		}
	}
}
