{
	"bsonType": "object",
	"required": ["merchant_user_id", "amount", "month_no", "create_time"],
	"permission": {
		"read": true,
		"create": true,
		"update": true,
		"delete": true
	},
	"properties": {
		"_id": {
			"description": "主键"
		},
		"merchant_user_id": {
			"bsonType": "string",
			"description": "商户ID(user_id或_id)"
		},
		"month_no": {
			"bsonType": "string",
			"description": "归属月份 YYYY-MM"
		},
		"title": {
			"bsonType": "string",
			"description": "红包标题"
		},
		"amount": {
			"bsonType": "number",
			"description": "红包金额",
			"default": 0
		},
		"status": {
			"bsonType": "string",
			"description": "pending=待领取,claimed=已领取,expired=过期",
			"default": "pending"
		},
		"claimed_time": {
			"bsonType": "timestamp",
			"description": "领取时间"
		},
		"expire_time": {
			"bsonType": "timestamp",
			"description": "过期时间"
		},
		"create_time": {
			"bsonType": "timestamp",
			"description": "创建时间"
		},
		"update_time": {
			"bsonType": "timestamp",
			"description": "更新时间"
		},
		"is_deleted": {
			"bsonType": "bool",
			"description": "软删除",
			"default": false
		}
	}
}
