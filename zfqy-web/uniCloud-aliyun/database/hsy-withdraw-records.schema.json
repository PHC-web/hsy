{
	"bsonType": "object",
	"required": ["create_time"],
	"permission": { "read": true, "create": true, "update": true, "delete": true },
	"properties": {
		"_id": { "description": "主键" },
		"withdraw_no": { "bsonType": "string", "description": "提现单号" },
		"merchant_user_id": { "bsonType": "string", "description": "商户用户ID" },
		"user_nickname": { "bsonType": "string", "description": "用户昵称" },
		"user_mobile": { "bsonType": "string", "description": "手机号" },
		"device_id": { "bsonType": "string", "description": "机具号" },
		"company": { "bsonType": "string", "description": "分公司" },
		"salesman": { "bsonType": "string", "description": "业务员" },
		"amount": { "bsonType": "number", "description": "提现金额(元)", "default": 0 },
		"fee_tax": { "bsonType": "number", "description": "税费+手续费(元)", "default": 0 },
		"payable": { "bsonType": "number", "description": "应付金额(元)", "default": 0 },
		"is_paid": { "bsonType": "bool", "description": "是否已打款", "default": false },
		"pay_time": { "bsonType": "timestamp", "description": "打款时间" },
		"arrival_status": { "bsonType": "string", "description": "到账状态：pending=未到账，received=已到账，returned=已退回，expired=已过期", "default": "pending" },
		"arrival_time": { "bsonType": "timestamp", "description": "到账时间" },
		"create_time": { "bsonType": "timestamp", "description": "创建时间" },
		"update_time": { "bsonType": "timestamp", "description": "更新时间" },
		"delete_time": { "bsonType": "timestamp", "description": "删除时间" },
		"delete_user": { "bsonType": "string", "description": "删除人" },
		"is_deleted": { "bsonType": "bool", "description": "软删", "default": false },
		"withdraw_member_bucket": {
			"bsonType": "string",
			"description": "提现发起时的会员分档：member=充值会员(钻石/铂金/白金等)；non_member=普通/白银。历史单由首页汇总接口按当前身份分批回填。"
		}
	}
}
