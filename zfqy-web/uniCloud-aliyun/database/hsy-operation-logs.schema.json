{
	"bsonType": "object",
	"description": "操作日志表，记录用户对系统的操作",
	"required": [],
	"permission": {
		"read": "true",
		"create": "true",
		"update": "false",
		"delete": "false"
	},
	"properties": {
		"_id": { "description": "ID，系统自动生成" },
		"user_id": { "bsonType": "string", "description": "操作用户ID" },
		"user_name": { "bsonType": "string", "description": "操作用户名称" },
		"action": { "bsonType": "string", "description": "操作类型: add, update, delete" },
		"module": { "bsonType": "string", "description": "操作模块: brand, user, etc." },
		"target_id": { "bsonType": "string", "description": "操作目标ID" },
		"target_name": { "bsonType": "string", "description": "操作目标名称" },
		"content": { "bsonType": "string", "description": "操作内容详情" },
		"operator_source": { "bsonType": "string", "description": "操作来源：admin/h5/system" },
		"reason": { "bsonType": "string", "description": "操作原因" },
		"before_merchant_snapshot": { "bsonType": "object", "description": "解绑前商户快照" },
		"before_machine_snapshot": { "bsonType": "object", "description": "解绑前机具快照" },
		"ip": { "bsonType": "string", "description": "操作IP地址" },
		"create_time": { "bsonType": "timestamp", "description": "操作时间" },
		"is_deleted": { "bsonType": "bool", "description": "软删除", "default": false },
		"delete_time": { "bsonType": "timestamp", "description": "删除时间" },
		"delete_user": { "bsonType": "string", "description": "删除人" }
	}
}
