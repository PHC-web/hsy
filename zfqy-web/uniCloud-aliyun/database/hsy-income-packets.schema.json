{
	"bsonType": "object",
	"required": ["merchant_user_id", "amount", "month_no", "create_time"],
	"permission": { "read": true, "create": true, "update": true, "delete": true },
	"properties": {
		"_id": { "description": "主键" },
		"merchant_user_id": { "bsonType": "string", "description": "商户ID(user_id或_id)" },
		"month_no": { "bsonType": "string", "description": "归属月份 YYYY-MM" },
		"title": { "bsonType": "string", "description": "红包标题" },
		"amount": { "bsonType": "number", "description": "红包金额", "default": 0 },
		"status": { "bsonType": "string", "description": "pending=待领取,claimed=已领取,expired=过期", "default": "pending" },
		"claimed_time": { "bsonType": "timestamp", "description": "领取时间" },
		"expire_time": { "bsonType": "timestamp", "description": "过期时间" },
		"claim_open_time": { "bsonType": "timestamp", "description": "可开始领取时间" },
		"subsidy_kind": {
			"bsonType": "string",
			"description": "recharge_vesting=充值用户分期；non_recharge_lump=非充值5万档；non_recharge_extra=非充值每满1万；coupon_reward=优惠券达标奖励"
		},
		"dedup_key": { "bsonType": "string", "description": "防重复生成键" },
		"coupon_instance_id": { "bsonType": "string", "description": "关联 hsy-coupon-instances，领取后回写券状态" },
		"subsidy_flow_month": { "bsonType": "string", "description": "流水归属月 YYYY-MM" },
		"subsidy_block_index": { "bsonType": "int", "description": "万元档序号(0起)" },
		"installment_index": { "bsonType": "int", "description": "第几期(1-5)" },
		"anchor_flow_yuan": { "bsonType": "number", "description": "锚定流水月总额(元)，用于第2期起领取门槛" },
		"unlock_flow_yuan": { "bsonType": "number", "description": "领取时当月合理流水需达到的最小值(元)" },
		"create_time": { "bsonType": "timestamp", "description": "创建时间" },
		"update_time": { "bsonType": "timestamp", "description": "更新时间" },
		"is_deleted": { "bsonType": "bool", "description": "软删除", "default": false }
	}
}
