		"orderdat": { "bsonType": "string", "description": "交易日期yyyyMMdd" },
		"ordertime": { "bsonType": "string", "description": "交易时间HHmmss" },
		"agentid": { "bsonType": "string", "description": "代理商编号" },
		"paychannel": {
			"bsonType": "string",
			"description": "支付方式(枚举): 01支付宝 02微信 03银联优惠 04银联未优惠 05标准借记卡 06标准贷记卡 11冻结款(押金) 12数币 31京东白条 00未知；未列出的值需联系星驿支付排查"
		},
		"paychannel_text": { "bsonType": "string", "description": "支付方式中文(入库时由 paychannel 解析)" },
		"txnamt": { "bsonType": "string", "description": "交易金额(元)" },
		"ysfee": { "bsonType": "string", "description": "应收手续费" },
