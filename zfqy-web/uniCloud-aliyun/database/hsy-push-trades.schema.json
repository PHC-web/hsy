		"mercid": { "bsonType": "string", "description": "商户号" },
		"termphyno": { "bsonType": "string", "description": "终端机身号(与机具管理 device_id 对应)" },
		"machine_in_system": {
			"bsonType": "bool",
			"description": "机具编号是否在后台机具库中存在；否时仅落库供对账，不参与刷卡记录列表"
		},
		"policyid": { "bsonType": "string", "description": "终端政策ID" },
