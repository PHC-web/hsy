		},
		"discount_flag_text": { "bsonType": "string", "description": "补贴类型中文(入库时由 discount_flag 解析)" },
		"sp_no": { "bsonType": "string", "description": "音箱号" },
		"txf": { "bsonType": "string", "description": "提现费" },
		"ssfl": { "bsonType": "string", "description": "实收费率" },
		"wlfwf": { "bsonType": "string", "description": "网络服务费" },
		"adjustid1": { "bsonType": "string" },
		"adjustfee1": { "bsonType": "string" },
		"adjustid2": { "bsonType": "string" },
		"adjustfee2": { "bsonType": "string" },
		"adjustid3": { "bsonType": "string" },
		"adjustfee3": { "bsonType": "string" },
		"adjustid4": { "bsonType": "string" },
		"adjustfee4": { "bsonType": "string" },
		"sffd": { "bsonType": "string", "description": "手续费是否封顶(枚举): 1是 0否" },
		"sffd_text": { "bsonType": "string", "description": "手续费是否封顶中文(入库时由 sffd 解析)" },
