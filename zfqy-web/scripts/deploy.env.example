# 复制为 scripts/deploy.env 后填写（deploy.env 已加入 .gitignore）
#
# 必填：SSH 登录用户名
SSH_USER=root
#
# 选填：SSH 端口，默认 22
SSH_PORT=22
#
# 选填：私钥路径。留空则使用 ssh 默认密钥（~/.ssh/id_ed25519、id_rsa 等）
# SSH_KEY=~/.ssh/id_ed25519
#
# 选填：若 docker 命令需要 sudo，设为 1
DOCKER_SUDO=0
#
# 前端网页托管（scripts/deploy-hosting.sh）
# 云空间名称或 spaceId。查看：
#   /Applications/HBuilderX.app/Contents/MacOS/cli cloud functions --list space --prj zfqy-web --provider aliyun
# UNICLOUD_SPACE=
# 选填：HBuilderX CLI 路径，Alpha 版需改成 HBuilderX-Alpha.app
# HBUILDERX_CLI=/Applications/HBuilderX.app/Contents/MacOS/cli
# 选填：上传到托管的目录前缀，默认根目录 /
# UNICLOUD_PREFIX=/
