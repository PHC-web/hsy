
.uni-container.data-v-0c19d6ad {
	padding: 16px;
	height: calc(100vh - 50px);
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
.header-actions.data-v-0c19d6ad {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-left: auto;
}
.table-wrap.data-v-0c19d6ad {
	flex: 1;
	min-height: 0;
	background: #fff;
	border-radius: 4px;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}
.row-ops.data-v-0c19d6ad {
	display: flex;
	gap: 6px;
	justify-content: center;
	align-items: center;
}
.row-ops button.data-v-0c19d6ad {
	min-width: 44px;
	padding: 0 8px;
	height: 24px;
	line-height: 24px;
}
.uni-pagination-box.data-v-0c19d6ad {
	padding: 12px 16px;
	text-align: right;
}
.export-dropdown.data-v-0c19d6ad {
	position: relative;
}
.export-trigger.data-v-0c19d6ad {
	display: flex;
	gap: 6px;
	align-items: center;
}
.export-icon.data-v-0c19d6ad,
.export-caret.data-v-0c19d6ad {
	font-size: 12px;
}
.export-menu.data-v-0c19d6ad {
	position: absolute;
	top: calc(100% + 6px);
	left: 0;
	min-width: 130px;
	background: #fff;
	border: 1px solid #ebeef5;
	border-radius: 4px;
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
	z-index: 20;
	padding: 4px 0;
}
.export-menu-item.data-v-0c19d6ad {
	padding: 8px 12px;
	font-size: 12px;
	color: #303133;
	cursor: pointer;
}
.export-menu-item.data-v-0c19d6ad:hover {
	background: #f5f7fa;
	color: #409eff;
}
.dialog-panel.data-v-0c19d6ad {
	width: 760px;
	background: #fff;
	border-radius: 8px;
	padding: 18px 22px;
	max-height: 80vh;
	overflow-y: auto;
}
.dialog-title.data-v-0c19d6ad {
	font-size: 20px;
	font-weight: 600;
	color: #303133;
	margin-bottom: 12px;
}
.preview-card.data-v-0c19d6ad {
	display: flex;
	justify-content: space-between;
	align-items: center;
	background: linear-gradient(120deg, #e6f7ef 0%, #f4efff 100%);
	border-radius: 8px;
	padding: 14px 16px;
	margin-bottom: 14px;
}
.preview-left.data-v-0c19d6ad {
	display: flex;
	align-items: center;
	gap: 8px;
}
.preview-label.data-v-0c19d6ad {
	color: #606266;
	font-size: 15px;
}
.preview-price.data-v-0c19d6ad {
	color: #f56c6c;
	font-size: 36px;
	font-weight: 700;
	line-height: 1;
}
.preview-btn.data-v-0c19d6ad {
	padding: 10px 20px;
	border-radius: 6px;
	background: #111;
	color: #fff;
	font-size: 16px;
}
.dialog-actions.data-v-0c19d6ad {
	margin-top: 14px;
	display: flex;
	gap: 10px;
}
@media (max-width: 900px) {
.dialog-panel.data-v-0c19d6ad {
		width: 92vw;
}
}

