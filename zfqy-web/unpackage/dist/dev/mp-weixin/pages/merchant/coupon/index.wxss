
.uni-container.data-v-2699c3e7 {
	padding: 16px;
	height: calc(100vh - 50px);
	display: flex;
	flex-direction: column;
	overflow: hidden;
}
.header-actions.data-v-2699c3e7 {
	display: flex;
	align-items: center;
	gap: 8px;
	margin-left: auto;
}
.export-dropdown.data-v-2699c3e7 {
	position: relative;
}
.export-trigger.data-v-2699c3e7 {
	display: flex;
	gap: 8px;
	align-items: center;
}
.export-icon.data-v-2699c3e7,
.export-caret.data-v-2699c3e7 {
	font-size: 12px;
}
.export-menu.data-v-2699c3e7 {
	position: absolute;
	top: calc(100% + 6px);
	left: 0;
	min-width: 130px;
	background: #fff;
	border: 1px solid #ebeef5;
	border-radius: 4px;
	box-shadow: 0 6px 16px rgba(0, 0, 0, 0.12);
	z-index: 20;
	padding: 4px 0;
}
.export-menu-item.data-v-2699c3e7 {
	padding: 8px 12px;
	font-size: 12px;
	color: #303133;
	cursor: pointer;
}
.export-menu-item.data-v-2699c3e7:hover {
	background: #f5f7fa;
	color: #409eff;
}
.table-wrap.data-v-2699c3e7 {
	flex: 1;
	min-height: 0;
	background: #fff;
	border-radius: 4px;
	box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08);
	overflow: hidden;
	display: flex;
	flex-direction: column;
}
.row-ops.data-v-2699c3e7 {
	display: flex;
	gap: 6px;
	justify-content: center;
	align-items: center;
	flex-wrap: nowrap;
}
.row-ops button.data-v-2699c3e7 {
	min-width: 44px;
	padding: 0 8px;
	height: 24px;
	line-height: 24px;
}
.uni-pagination-box.data-v-2699c3e7 {
	padding: 12px 16px;
	text-align: right;
}
.dialog-panel.data-v-2699c3e7 {
	width: 720px;
	background: #fff;
	border-radius: 8px;
	padding: 18px 22px;
}
.dialog-title.data-v-2699c3e7 {
	font-size: 20px;
	font-weight: 600;
	color: #303133;
